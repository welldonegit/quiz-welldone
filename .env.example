PORT=3001
NODE_ENV=development
# Якщо фронт і API на різних доменах — вкажіть дозволений origin (інакше лишіть порожнім = той самий origin)
ALLOWED_ORIGIN=
# Кількість проксі перед застосунком (для коректного IP). 1 для типового Nginx.
TRUST_PROXY=1
# Шлях до файлу заявок (необов’язково; за замовчуванням data/leads.jsonl)
# LEADS_FILE=

# ── Етап 2 (Telegram) ──
# Токен бота від @BotFather. НІКОЛИ не потрапляє у фронтенд.
TELEGRAM_BOT_TOKEN=
# Куди слати заявки. Можна кілька id через кому: -1001234567890,123456789
# Дізнатись id: напишіть боту й запустіть `npm run tg:chatid`.
TELEGRAM_CHAT_ID=
# Необов'язково: id теми (topic) для груп з темами — message_thread_id.
TELEGRAM_THREAD_ID=
